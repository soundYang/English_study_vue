# 后端接口地址（VITE_USE_MOCK=false 时生效）
VITE_API_BASE_URL=http://localhost:3000/api

# 数据层开关：true 使用本地 Mock，false 请求真实后端。
# 设为 false 后构建还会把 mock/adapter 换成空占位：演示账号与种子数据不进 dist（md/40 H-2）。
# 生产包必须显式写 false，否则构建时会打印一条警告（数据源是 Mock，页面全离线）
VITE_USE_MOCK=true

# 与后端 AUTH_ENFORCED 保持一致：true 时未登录会被路由守卫送到 /login
# 当前后端已开启强制鉴权；如果本地后端仍是 false（回落 local-user），联调时改回 false
VITE_AUTH_ENFORCED=true
